---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { articles } from '../data/site';

// 动态绑定全站文章库：随文章库实时自动统计数量，无需手动维护
const totalArticles = articles.length;
const ltArticles = articles.filter((a) => a.author.includes('LT'));
const displayArticles = ltArticles.length > 0 ? ltArticles : articles;
---

<BaseLayout title="关于 LT｜biaopiao" description="LT 个人专栏与权威评测档案 - biaopiao (baipiaojc.com)">
  <Header />

  <main class="author-page-wrapper">
    <!-- Exact Author Profile Card matching user screenshot -->
    <section class="bp-author-box" aria-label="LT 个人资料">
      <div class="author-box-main">
        <!-- 96px Circular Avatar locked with inline styles -->
        <div class="author-box-avatar">
          <img
            src="/avatar-lt.webp"
            alt="LT"
            width="96"
            height="96"
            style="width: 96px; height: 96px; min-width: 96px; max-width: 96px; border-radius: 50%; object-fit: cover; display: block;"
          />
        </div>

        <!-- Info Column -->
        <div class="author-box-info">
          <!-- Name with green dotted underline + Verified Badge -->
          <div class="author-box-name-row">
            <h1 class="author-box-name" style="margin: 0;">LT</h1>
            <span class="author-verified-icon" title="已认证" aria-label="已认证">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="#10b981">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1.2 14.2l-3.5-3.5 1.4-1.4 2.1 2.1 5.6-5.6 1.4 1.4-7 7z"/>
              </svg>
            </span>
          </div>

          <!-- Bio text matching screenshot -->
          <p class="author-box-bio">
            LT，独立网络体验与工具观察者。聚焦机场服务、客户端与流媒体使用，把复杂参数还原成清晰、可复用的选择建议。
          </p>

          <!-- Follow Row -->
          <div class="author-box-meta">
            <span class="author-meta-role">博主</span>
            <span class="author-meta-slash">/</span>
            <span class="author-meta-follow">跟随:</span>
            <div class="author-box-socials">
              <a href="https://t.me/wanfengzn7" target="_blank" rel="noopener noreferrer" class="author-social-btn" aria-label="Telegram">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m22 2-7 20-4-9-9-4Z" />
                  <path d="M22 2 11 13" />
                </svg>
              </a>
              <a href="https://x.com/Reganuphc" target="_blank" rel="noopener noreferrer" class="author-social-btn" aria-label="X">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
              <a href="https://www.youtube.com/@Ryan-W77" target="_blank" rel="noopener noreferrer" class="author-social-btn" aria-label="YouTube">
                <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Stat: 35 文章 -->
      <div class="author-box-count">
        <div class="author-count-num">{totalArticles}</div>
        <div class="author-count-label">文章</div>
      </div>
    </section>

    <!-- Archive Entry Card (Placed right below blogger profile card) -->
    <a href="/archive" class="author-archive-banner" aria-label="进入全站文章归档索引库">
      <div class="archive-banner-left">
        <div class="archive-banner-badge">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="21 8 21 21 3 21 3 8" />
            <rect x="1" y="3" width="22" height="5" />
            <line x1="10" y1="12" x2="14" y2="12" />
          </svg>
          <span>CURATED ARCHIVE</span>
        </div>
        <h2 class="archive-banner-title">全站文章归档索引库</h2>
        <p class="archive-banner-desc">一站式查阅全站所有技术指南、机场评测、客户端教程与实用工具，按时间与分类有序索引。</p>
      </div>

      <div class="archive-banner-right">
        <span class="archive-btn-text">浏览全部归档</span>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="archive-btn-arrow">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
      </div>
    </a>

    <!-- Latest Articles with Green Dotted Underline as visible in screenshot -->
    <section class="author-latest-articles" aria-label="最新文章">
      <div class="author-section-title">
        <h2>最新文章</h2>
      </div>

      <div class="bp-card-grid">
        {displayArticles.map((post) => (
          <a href={`/posts/${post.slug}`} class="bp-post-card">
            <div class="card-thumbnail-wrap">
              <img
                src={post.image.startsWith('/') ? post.image : post.image === 'card' ? '/card-network.webp' : '/feature-network.webp'}
                alt={post.title}
                class="card-thumb-img"
                loading="lazy"
              />
              <span class="card-tag">{post.category}</span>
            </div>
            <div class="card-body">
              <h3>{post.title}</h3>
              <p>{post.excerpt}</p>
              <div class="card-footer">
                <span>LT-博主 · {post.readTime}</span>
                <span>{post.date}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <!-- Dark Footer with Disclaimer -->
  <Footer />
</BaseLayout>
