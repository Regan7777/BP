---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { trendingArticles } from '../data/site';
---

<BaseLayout title="biaopiao - 机场推荐与前沿网络指南" description="biaopiao (baipiaojc.com) 提供专业的网络代理工具、机场测速评测与节点排错实用指南。">
  <Header />

  <main class="bp-main-content">
    <!-- Hero / Featured Section matching user's exact design -->
    <section class="bp-hero-section" aria-label="焦点推荐">
      <!-- Left Column: 全平台保姆级教程（置顶焦点推荐） -->
      <div class="hero-left">
        <h1 class="hero-heading">全平台保姆级教程：从客户端下载、机场订阅到连通性测试一站式通关</h1>
        <p class="hero-desc">
          完全零技术门槛大白话讲透科学上网：自研一键客户端与开源工具选型、订阅一键导入、规则模式分流防坑指南，更有 10 大高频排错问答彻底打通外网。
        </p>

        <a href="/posts/beginner-complete-guide" class="hero-featured-card" aria-label="全平台保姆级教程">
          <div class="green-accent-bar" aria-hidden="true"></div>
          <img
            src="/guide-hero.webp"
            alt="全平台保姆级教程：客户端下载与订阅测速一站式通关"
            class="hero-featured-image"
            loading="eager"
          />
        </a>
      </div>

      <!-- Right Column: Exact Magenta to Purple Card -->
      <div class="hero-right">
        <div class="editor-pick-header">
          <span class="editor-dot" aria-hidden="true"></span>
          <span>编辑推荐</span>
        </div>

        <div class="exact-magenta-card">
          {trendingArticles.map((article) => (
            <a href={`/posts/${article.slug}`} class="trending-item-exact">
              <div class="trending-row-exact">
                <!-- Trending Arrow matching user screenshot -->
                <svg
                  class="trending-arrow-exact"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M7 17L17 7" />
                  <path d="M7 7h10v10" />
                </svg>
                <span class="trending-title-exact">{article.title}</span>
              </div>
              <div class="trending-meta-exact">
                <span class="meta-author">{article.author}</span>
                <span class="meta-sep">|</span>
                <span class="meta-date">{article.updatedDate || article.date}</span>
              </div>
            </a>
          ))}
        </div>

        <!-- Hero Right Search Bar (放置在编辑推荐/美区ID卡片下方，留出呼吸间隙) -->
        <div
          class="hero-search-card"
          id="openSearchBtnHero"
          role="button"
          tabindex="0"
          aria-label="全站搜索 (快捷键 ⌘K / Ctrl+K)"
          data-open-search="true"
        >
          <div class="hero-search-inner">
            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="hero-search-icon"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span class="hero-search-placeholder">搜索全站文章、客户端配置、网络排错...</span>
            <div class="hero-search-shortcuts">
              <kbd class="hero-search-kbd">⌘K / Ctrl+K</kbd>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Social Network Section matching user's photo -->
    <section class="bp-social-network-section" aria-label="社交网络">
      <div class="social-section-header">
        <span class="social-dot" aria-hidden="true"></span>
        <h2 class="social-title">社交网络</h2>
      </div>

      <div class="social-cards-grid">
        <!-- YouTube -->
        <a href="https://www.youtube.com/@Ryan-W77" target="_blank" rel="noopener noreferrer" class="social-banner-card card-youtube">
          <div class="social-card-inner">
            <svg class="social-banner-icon" viewBox="0 0 24 24" width="30" height="30" fill="currentColor">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            <div class="social-card-texts">
              <span class="social-card-platform">YouTube</span>
              <span class="social-card-action">订阅</span>
            </div>
          </div>
        </a>

        <!-- X -->
        <a href="https://x.com/Reganuphc" target="_blank" rel="noopener noreferrer" class="social-banner-card card-x">
          <div class="social-card-inner">
            <svg class="social-banner-icon" viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
            <div class="social-card-texts">
              <span class="social-card-platform">X</span>
              <span class="social-card-action">跟随</span>
            </div>
          </div>
        </a>

        <!-- TikTok -->
        <a href="https://www.tiktok.com/@7regan7" target="_blank" rel="noopener noreferrer" class="social-banner-card card-tiktok">
          <div class="social-card-inner">
            <svg class="social-banner-icon" viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
              <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.97-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 2.89 3.5 2.76 1.52-.07 2.8-1.18 3.04-2.67.11-.69.11-1.4.11-2.1V.02z"/>
            </svg>
            <div class="social-card-texts">
              <span class="social-card-platform">TikTok</span>
              <span class="social-card-action">跟随</span>
            </div>
          </div>
        </a>

        <!-- Telegram -->
        <a href="https://t.me/wanfengzn7" target="_blank" rel="noopener noreferrer" class="social-banner-card card-telegram">
          <div class="social-card-inner">
            <svg class="social-banner-icon" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m22 2-7 20-4-9-9-4Z" />
              <path d="M22 2 11 13" />
            </svg>
            <div class="social-card-texts">
              <span class="social-card-platform">Telegram</span>
              <span class="social-card-action">加入频道</span>
            </div>
          </div>
        </a>
      </div>
    </section>
  </main>

  <!-- Dark Footer with Disclaimer -->
  <Footer />
</BaseLayout>
