---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="404 - 页面未找到｜biaopiao"
  description="抱歉，您访问的页面不存在或已被移除。biaopiao 为您提供最新的机场评测与科学上网配置指南。"
>
  <Header showAd={false} />

  <main class="notfound-container">
    <div class="notfound-ambient" aria-hidden="true"></div>

    <div class="notfound-card">
      <div class="notfound-code">404</div>
      <h1 class="notfound-title">页面未找到 / Resource Not Found</h1>
      <p class="notfound-desc">
        您访问的资源地址可能已被调整、合并或移除。请确认链接拼写无误，或直接通过下方推荐快速前往核心内容。
      </p>

      <div class="notfound-actions">
        <a href="/" class="notfound-btn-primary">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          返回博客首页
        </a>
        <a href="/posts/shenxingjiasu-review" class="notfound-btn-secondary">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
          阅读精选：神行加速深度评测
        </a>
      </div>

      <div class="notfound-quicklinks">
        <span class="quicklinks-label">常用快捷入口：</span>
        <div class="quicklinks-row">
          <a href="/category/recommendations">机场推荐</a>
          <span class="quicklinks-sep">/</span>
          <a href="/category/reviews">机场评测</a>
          <span class="quicklinks-sep">/</span>
          <a href="/category/tutorials">客户端教程</a>
          <span class="quicklinks-sep">/</span>
          <a href="/archive">文章归档</a>
          <span class="quicklinks-sep">/</span>
          <a href="/about">关于博主</a>
        </div>
      </div>
    </div>
  </main>

  <!-- Global Dark Footer with Disclaimer -->
  <Footer />
</BaseLayout>

<style>
  .notfound-container {
    position: relative;
    min-height: calc(100vh - 280px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 24px;
    background-color: #000000;
    overflow: hidden;
  }

  .notfound-ambient {
    position: absolute;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(235, 0, 137, 0.18) 0%, rgba(102, 0, 167, 0.12) 40%, transparent 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 1;
    filter: blur(40px);
  }

  .notfound-card {
    position: relative;
    z-index: 2;
    max-width: 680px;
    width: 100%;
    text-align: center;
    background: #0d0f14;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 60px 40px;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.7);
  }

  .notfound-code {
    font-family: 'Oswald', sans-serif;
    font-size: 110px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
    background: linear-gradient(135deg, #00f0a0 0%, #ffffff 50%, #eb0089 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 12px;
    user-select: none;
  }

  .notfound-title {
    font-size: 24px;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 16px 0;
    letter-spacing: -0.01em;
  }

  .notfound-desc {
    font-size: 15px;
    line-height: 1.7;
    color: #9ca3af;
    margin: 0 auto 36px;
    max-width: 520px;
  }

  .notfound-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .notfound-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #10b981;
    color: #000000;
    font-size: 14.5px;
    font-weight: 700;
    padding: 12px 24px;
    border-radius: 10px;
    text-decoration: none;
    transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .notfound-btn-primary:hover {
    background: #00f0a0;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 240, 160, 0.3);
  }

  .notfound-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #181a20;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 14.5px;
    font-weight: 700;
    padding: 12px 24px;
    border-radius: 10px;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .notfound-btn-secondary:hover {
    border-color: #eb0089;
    background: #20222a;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(235, 0, 137, 0.2);
  }

  .notfound-quicklinks {
    padding-top: 28px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .quicklinks-label {
    display: block;
    font-size: 12px;
    color: #6b7280;
    margin-bottom: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .quicklinks-row {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .quicklinks-row a {
    color: #9ca3af;
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .quicklinks-row a:hover {
    color: #00f0a0;
  }

  .quicklinks-sep {
    color: #4b5563;
    font-size: 12px;
  }

  @media (max-width: 640px) {
    .notfound-card {
      padding: 40px 24px;
    }
    .notfound-code {
      font-size: 80px;
    }
    .notfound-actions {
      flex-direction: column;
    }
    .notfound-btn-primary, .notfound-btn-secondary {
      width: 100%;
      justify-content: center;
    }
  }
</style>
