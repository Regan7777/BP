---
import BrandLogo from './BrandLogo.astro';
---

<footer class="bp-site-footer">
  <div class="footer-inner">
    <div class="footer-main-row">
      <BrandLogo isFooter={true} />
      <div class="footer-links">
        <a href="/">首页</a>
        <a href="/category/recommendations">机场推荐</a>
        <a href="/category/reviews">机场评测</a>
        <a href="/category/tutorials">客户端教程</a>
        <a href="/tools">实用工具</a>
        <a href="/archive">文章归档</a>
        <a href="/about">关于</a>
      </div>
      <div class="footer-copy">
        © 2026 biaopiao (baipiaojc.com). All rights reserved.
      </div>
    </div>

    <!-- 底部免责声明 -->
    <div class="footer-disclaimer">
      <p class="disclaimer-text">
        <strong>免责声明</strong>：本站所有文章与技术评测均基于公开网络资料整理及计算机网络协议（Shadowsocks、VLESS、Hysteria 2、Clash、Sing-box 等）学术研究探讨，仅供网络技术学习、网络排障与合规出海交流使用。本站不提供任何科学上网代理工具销售、节点接入或商用服务，亦不与任何第三方机场服务商存在隶属关系。使用者请严格遵守所在国家与地区的法律法规，文明合规使用互联网。
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
  }
  .footer-main-row {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }
  .footer-disclaimer {
    width: 100%;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin-top: 22px;
    padding-top: 18px;
  }
  .disclaimer-text {
    margin: 0;
    font-size: 11.5px;
    line-height: 1.75;
    color: #6b7280;
    text-align: justify;
    letter-spacing: 0.01em;
  }
  .disclaimer-text strong {
    color: #9ca3af;
    font-weight: 600;
  }
</style>
