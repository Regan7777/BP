---
import { articles } from '../data/site';

// Create a compact search index passed to the client
const searchData = articles.map((a) => ({
  title: a.title,
  slug: a.slug,
  category: a.category,
  excerpt: a.excerpt,
  date: a.updatedDate || a.date,
  readTime: a.readTime,
  keywords: a.keywords || []
}));
---

<div id="searchModal" class="search-modal-backdrop" aria-hidden="true" role="dialog" aria-modal="true" aria-label="全站搜索">
  <div class="search-modal-card" id="searchModalCard">
    <!-- Search Bar Top Input -->
    <div class="search-bar-row">
      <svg class="search-modal-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>

      <input
        type="search"
        id="globalSearchInput"
        class="search-modal-input"
        placeholder="搜索文章、客户端配置、网络排错、协议评测..."
        autocomplete="off"
        spellcheck="false"
      />

      <button id="closeSearchModalBtn" class="search-close-btn" type="button" aria-label="关闭搜索 (ESC)">
        <kbd>ESC</kbd>
      </button>
    </div>

    <!-- Search Dynamic Results Container -->
    <div class="search-results-area" id="searchResultsArea">
      <div class="search-empty-state" id="searchEmptyPrompt">
        <span class="empty-state-label">🔥 热门搜索推荐</span>
        <div class="search-quick-tags">
          <button type="button" class="search-quick-tag" data-tag="神行加速">神行加速</button>
          <button type="button" class="search-quick-tag" data-tag="Clash Verge">Clash Verge</button>
          <button type="button" class="search-quick-tag" data-tag="小火箭">Shadowrocket</button>
          <button type="button" class="search-quick-tag" data-tag="v2rayNG">v2rayNG</button>
          <button type="button" class="search-quick-tag" data-tag="Apple ID">美区 Apple ID</button>
          <button type="button" class="search-quick-tag" data-tag="Claude">Claude 封号</button>
          <button type="button" class="search-quick-tag" data-tag="规则模式">规则模式</button>
        </div>
      </div>

      <div class="search-list-group" id="searchListGroup">
        <!-- Rendered by client script -->
      </div>
    </div>

    <!-- Bottom Status Bar -->
    <div class="search-modal-footer">
      <div class="search-footer-nav-tips">
        <span><kbd>↑</kbd> <kbd>↓</kbd> 选择</span>
        <span><kbd>↵</kbd> 跳转</span>
        <span><kbd>ESC</kbd> 退出</span>
      </div>
      <div class="search-footer-brand">
        <span>biaopiao 毫秒搜索</span>
      </div>
    </div>
  </div>
</div>

<style>
  .search-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999999;
    background: rgba(0, 0, 0, 0.78);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 80px 20px 40px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  .search-modal-backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }

  .search-modal-card {
    background: #0d0f14;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    width: 100%;
    max-width: 680px;
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.8), 0 0 30px rgba(0, 240, 160, 0.15);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: translateY(-16px) scale(0.98);
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .search-modal-backdrop.is-open .search-modal-card {
    transform: translateY(0) scale(1);
  }

  .search-bar-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: #11141b;
  }

  .search-modal-icon {
    color: #00f0a0;
    flex-shrink: 0;
  }

  .search-modal-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #ffffff;
    font-size: 16px;
    font-weight: 600;
    font-family: inherit;
  }

  .search-modal-input::placeholder {
    color: #6b7280;
    font-size: 15px;
    font-weight: 400;
  }

  .search-close-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .search-close-btn kbd {
    font-family: inherit;
    font-size: 11px;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #9ca3af;
    border-radius: 5px;
    padding: 3px 7px;
    line-height: 1;
  }

  .search-results-area {
    max-height: 440px;
    overflow-y: auto;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .search-results-area::-webkit-scrollbar {
    width: 6px;
  }

  .search-results-area::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 3px;
  }

  .search-empty-state {
    padding: 18px 12px 14px;
  }

  .empty-state-label {
    display: block;
    font-size: 12px;
    font-weight: 700;
    color: #6b7280;
    margin-bottom: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .search-quick-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .search-quick-tag {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #d1d5db;
    font-size: 13px;
    font-weight: 500;
    padding: 6px 12px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .search-quick-tag:hover {
    background: rgba(0, 240, 160, 0.12);
    border-color: rgba(0, 240, 160, 0.4);
    color: #00f0a0;
    transform: translateY(-1px);
  }

  .search-list-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  :global(.search-result-item) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 14px;
    border-radius: 10px;
    text-decoration: none;
    border: 1px solid transparent;
    background: rgba(255, 255, 255, 0.02);
    transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }

  :global(.search-result-item:hover),
  :global(.search-result-item.is-selected) {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(0, 240, 160, 0.35);
    transform: translateX(3px);
  }

  :global(.search-item-header) {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  :global(.search-item-tag) {
    font-size: 11px;
    font-weight: 700;
    color: #00f0a0;
    background: rgba(0, 240, 160, 0.12);
    padding: 2px 7px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  :global(.search-item-title) {
    font-size: 14.5px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.4;
    flex: 1;
  }

  :global(.search-item-desc) {
    font-size: 12.5px;
    line-height: 1.5;
    color: #9ca3af;
    margin: 2px 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.search-item-meta) {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11.5px;
    color: #6b7280;
    margin-top: 4px;
  }

  :global(.search-highlight) {
    color: #00f0a0;
    background: rgba(0, 240, 160, 0.15);
    padding: 1px 3px;
    border-radius: 3px;
  }

  :global(.search-no-results) {
    text-align: center;
    padding: 36px 20px;
    color: #6b7280;
    font-size: 14px;
  }

  .search-modal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 20px;
    background: #090a0e;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 12px;
    color: #6b7280;
  }

  .search-footer-nav-tips {
    display: flex;
    gap: 14px;
  }

  .search-footer-nav-tips kbd {
    font-family: inherit;
    background: rgba(255, 255, 255, 0.08);
    padding: 1px 5px;
    border-radius: 3px;
    color: #d1d5db;
    font-size: 11px;
  }

  .search-footer-brand {
    font-weight: 600;
    color: #4b5563;
  }

  @media (max-width: 640px) {
    .search-modal-backdrop {
      padding: 20px 12px;
    }
    .search-footer-nav-tips {
      display: none;
    }
  }
</style>

<script is:inline define:vars={{ searchData }}>
  (function () {
    let selectedIndex = 0;
    let currentResults = [];

    const modal = document.getElementById('searchModal');
    const modalInput = document.getElementById('globalSearchInput');
    const resultsArea = document.getElementById('searchListGroup');
    const emptyPrompt = document.getElementById('searchEmptyPrompt');
    const closeBtn = document.getElementById('closeSearchModalBtn');

    function openModal() {
      if (!modal) return;
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      if (modalInput) {
        modalInput.value = '';
        setTimeout(() => modalInput.focus(), 50);
      }
      renderResults('');
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function escapeRegExp(string) {
      return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    function highlightText(text, query) {
      if (!query || !text) return text;
      const regex = new RegExp(`(${escapeRegExp(query)})`, 'gi');
      return text.replace(regex, '<span class="search-highlight">$1</span>');
    }

    function renderResults(query) {
      const q = query.trim().toLowerCase();
      selectedIndex = 0;

      if (!q) {
        if (emptyPrompt) emptyPrompt.style.display = 'block';
        // Show 4 top articles as default
        currentResults = searchData.slice(0, 4);
      } else {
        if (emptyPrompt) emptyPrompt.style.display = 'none';
        currentResults = searchData.filter((item) => {
          const inTitle = item.title.toLowerCase().includes(q);
          const inDesc = item.excerpt.toLowerCase().includes(q);
          const inCat = item.category.toLowerCase().includes(q);
          const inKeywords = (item.keywords || []).some((k) => k.toLowerCase().includes(q));
          return inTitle || inDesc || inCat || inKeywords;
        }).slice(0, 8);
      }

      if (currentResults.length === 0) {
        resultsArea.innerHTML = `<div class="search-no-results">未找到与 “${query}” 相关的文章，换个关键词试试？</div>`;
        return;
      }

      resultsArea.innerHTML = currentResults.map((item, index) => {
        const isSelected = index === selectedIndex;
        const highlightedTitle = q ? highlightText(item.title, q) : item.title;
        const highlightedDesc = q ? highlightText(item.excerpt, q) : item.excerpt;

        return `
          <a href="/posts/${item.slug}" class="search-result-item ${isSelected ? 'is-selected' : ''}" data-index="${index}">
            <div class="search-item-header">
              <span class="search-item-tag">${item.category}</span>
              <span class="search-item-title">${highlightedTitle}</span>
            </div>
            <p class="search-item-desc">${highlightedDesc}</p>
            <div class="search-item-meta">
              <span>LT-博主 · ${item.readTime}</span>
              <span>更新时间: ${item.date}</span>
            </div>
          </a>
        `;
      }).join('');
    }

    function updateSelection() {
      const items = resultsArea.querySelectorAll('.search-result-item');
      items.forEach((item, idx) => {
        if (idx === selectedIndex) {
          item.classList.add('is-selected');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('is-selected');
        }
      });
    }

    // Input typing listener
    if (modalInput) {
      modalInput.addEventListener('input', (e) => {
        renderResults(e.target.value);
      });
    }

    // Quick tag clicks
    document.querySelectorAll('.search-quick-tag').forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.getAttribute('data-tag') || '';
        if (modalInput) {
          modalInput.value = tag;
          renderResults(tag);
          modalInput.focus();
        }
      });
    });

    // Global Keydown Listeners (Cmd+K / Ctrl+K / ESC / Arrows / Enter)
    window.addEventListener('keydown', (e) => {
      const isCmdK = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k';
      if (isCmdK) {
        e.preventDefault();
        if (modal && modal.classList.contains('is-open')) {
          closeModal();
        } else {
          openModal();
        }
        return;
      }

      if (!modal || !modal.classList.contains('is-open')) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        closeModal();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (currentResults.length > 0) {
          selectedIndex = (selectedIndex + 1) % currentResults.length;
          updateSelection();
        }
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (currentResults.length > 0) {
          selectedIndex = (selectedIndex - 1 + currentResults.length) % currentResults.length;
          updateSelection();
        }
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (currentResults[selectedIndex]) {
          window.location.href = `/posts/${currentResults[selectedIndex].slug}`;
        }
      }
    });

    // Close on backdrop click
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', closeModal);
    }

    // Connect to search triggers across the site (hero card, shortcuts)
    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('#openSearchBtnHero, #openSearchBtn, [data-open-search]');
      if (trigger) {
        e.preventDefault();
        openModal();
      }
    });
  })();
</script>
